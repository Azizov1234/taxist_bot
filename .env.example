# Telegram userbot
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_STRING_SESSION=

# Optional: userbot mode admin command javoblari va driver delivery uchun oddiy Bot API bot
TELEGRAM_BOT_TOKEN=
ADMIN_COMMAND_REPLY_MODE=bot
DRIVER_DELIVERY_MODE=auto
TELEGRAM_USE_WSS=true
TELEGRAM_LOGIN_MODE=auto
TELEGRAM_FORCE_SMS=false
TELEGRAM_CONNECTION_RETRIES=-1
TELEGRAM_RECONNECT_RETRIES=-1
TELEGRAM_RETRY_DELAY_MS=2000
TELEGRAM_STARTUP_CONNECT_MAX_ATTEMPTS=0
TELEGRAM_STARTUP_CONNECT_RETRY_MS=5000

# Chats
# Recommended (regional split)
PASSENGER_CHAT_IDS_TASHKENT=-1001242377173
PASSENGER_CHAT_IDS_GULISTON=-1002222222222
PASSENGER_CHAT_IDS_KOMSOMOL=
PASSENGER_CHAT_USERNAMES_TASHKENT=
PASSENGER_CHAT_USERNAMES_GULISTON=
PASSENGER_CHAT_USERNAMES_KOMSOMOL=kamsamolikmiz,Dehqonobod_taksi24,KamsamoltaksiN1,sohilobod_taksi,zarya_taksi,kamsamol_taksi
DRIVER_CHAT_ID_TASHKENT=-1003333333333
DRIVER_CHAT_ID_GULISTON=-1004444444444
DRIVER_CHAT_ID_KOMSOMOL=-1005555555555

# Legacy fallback (optional; if set, it is used where regional values are missing)
PASSENGER_CHAT_IDS=
DRIVER_CHAT_ID=
PASSENGER_HELP_GROUP_LINK=
DRIVER_PREMIUM_GROUP_LINK=
ADMIN_TELEGRAM_ID=123456789

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/taxi_userbot

# AI main settings
AI_ENABLED=false
AI_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,cloudflare
AI_MIN_CONFIDENCE=0.65
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1

# Gemini - main
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq - fallback 1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras - fallback 2
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter - fallback 3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=taxi-lead-userbot

# Cloudflare Workers AI - fallback 4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Userbot behavior
DELETE_SOURCE_MESSAGE_IF_ADMIN=true
DELETE_IGNORED_MESSAGE_IF_ADMIN=true
SEND_PRIVATE_ACK_TO_PASSENGER=true
LISTENER_BACKFILL_SECONDS=180
LISTENER_STARTUP_BACKFILL_LIMIT=20
STARTUP_BACKFILL_DELETE_SOURCE=false
SEND_FORMATTED_MESSAGE=true
DUPLICATE_WINDOW_MINUTES=5
LOG_LEVEL=info
NODE_ENV=development

# Optional legacy mode
# TELEGRAM_MODE=legacy
