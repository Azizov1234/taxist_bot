generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  SENT
  DELETED_FROM_SOURCE
  NOT_DELETED_NO_PERMISSION
  IGNORED
  DUPLICATE
  ERROR
}

enum KeywordType {
  LATIN
  CYRILLIC
  ROUTE
  EXTRA
}

enum KeywordCategory {
  PASSENGER
  DRIVER
  CARGO
  SPAM
  AMBIGUOUS
}

enum KeywordLanguage {
  LATIN
  CYRILLIC
  RUSSIAN
  MIXED
}

enum KeywordMatchType {
  EXACT
  PHRASE
  REGEX
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Lead {
  id                 Int        @id @default(autoincrement())
  sourceChatId       String
  sourceMessageId    Int
  sourceChatTitle    String?
  senderId           String?
  senderFullName     String?
  senderUsername     String?
  userId             String
  fullName           String
  username           String?
  phone              String?
  originalText       String
  normalizedText     String
  fromLocation       String?
  toLocation         String?
  passengerCount     Int?
  timeHint           String?
  confidence         Float?
  isDriverAd         Boolean    @default(false)
  isSpam             Boolean    @default(false)
  targetDriverChatId BigInt?
  driverMessageId    Int?
  errorMessage       String?
  detectedRoute      String?
  status             LeadStatus @default(NEW)
  forwardedMessageId Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([sourceChatId, sourceMessageId])
  @@index([senderId, normalizedText, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Keyword {
  id        Int         @id @default(autoincrement())
  word      String      @unique
  type      KeywordType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model KeywordDictionary {
  id         Int              @id @default(autoincrement())
  phrase     String
  normalized String
  category   KeywordCategory
  weight     Int              @default(1)
  language   KeywordLanguage  @default(MIXED)
  matchType  KeywordMatchType @default(PHRASE)
  source     String           @default("global")
  frequency  Int              @default(0)
  examples   Json?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([normalized, category, source])
  @@index([category, isActive])
  @@index([normalized])
  @@index([weight])
  @@index([frequency])
  @@index([matchType])
}

model BotLog {
  id        Int      @id @default(autoincrement())
  level     LogLevel
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

model RuntimeConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id                  Int       @id @default(autoincrement())
  telegramId          BigInt?   @unique
  username            String?   @unique
  role                AdminRole @default(ADMIN)
  isActive            Boolean   @default(true)
  createdByTelegramId BigInt?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([role, isActive])
  @@index([isActive, createdAt])
}
